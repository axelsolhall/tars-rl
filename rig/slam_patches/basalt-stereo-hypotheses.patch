+// TARS: settings for multi-hypothesis stereo matching, read from the environment so the stock
+// config files stay valid. TARS_STEREO_DEPTHS="0.25,0.5,1,2" (metres) turns it on.
+inline std::vector<double> tarsEnvList(const char* name) {
+  std::vector<double> out;
+  const char* s = std::getenv(name);
+  if (!s) return out;
+  std::stringstream ss(s);
+  std::string item;
+  while (std::getline(ss, item, ',')) out.push_back(std::stod(item));
+  return out;
+}
+
+inline double tarsEnvScalar(const char* name, double fallback) {
+  const char* s = std::getenv(name);
+  return s ? std::stod(s) : fallback;
+}
